# Copy to .env.prod on the VPS. Never commit the real .env.prod file.

POSTGRES_USER=elearning
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

AUTH_SERVER_IMAGE=elearning/auth-server:latest
RESOURCE_SERVER_IMAGE=elearning/resource-server:latest

AUTH_SERVER_PORT=9000
RESOURCE_SERVER_PORT=8081
MINIO_API_PORT=9003
MINIO_CONSOLE_PORT=9001

JWT_SECRET=change-me-use-a-long-random-secret
MOBILE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# No trailing slash for Spring issuer values.
AUTH_PUBLIC_ORIGIN=https://auth.example.com
RESOURCE_PUBLIC_ORIGIN=https://api.example.com
MINIO_PUBLIC_ORIGIN=https://s3.example.com
