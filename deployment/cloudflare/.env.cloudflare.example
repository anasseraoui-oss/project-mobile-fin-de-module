# Copy this file to .env.cloudflare and fill real values.
# Do not commit .env.cloudflare.

CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Required by the existing docker-compose.yml. Use a long random value.
JWT_SECRET=replace-with-long-random-dev-secret

# No trailing slash for Spring issuer values.
AUTH_PUBLIC_ORIGIN=https://auth-dev.example.com
RESOURCE_PUBLIC_ORIGIN=https://api-dev.example.com
MINIO_PUBLIC_ORIGIN=https://s3-dev.example.com
